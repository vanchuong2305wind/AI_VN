# Sao chép file này thành .env rồi điền API key. KHÔNG commit file .env.
# Cấu hình cho buổi thi: Qwen 3.7 Flash qua OpenRouter, 20 câu / 40 phút, ưu tiên đúng > nhanh > ít token.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=qwen/qwen3.7-flash

# Mức suy luận: off | low | medium | high | default. Trần reasoning cố định / lượt gọi (0 = theo effort).
REASONING=low
REASONING_MAX_TOKENS=2048

# 20 câu chạy cùng lúc -> tổng thời gian ≈ thời gian câu chậm nhất (~1-2 phút)
CONCURRENCY=20

# Các giá trị dưới đây đã là mặc định trong src/config.py, ghi ra để dễ chỉnh:
# CODE_SAMPLES=3         # số lời giải bằng code / câu (bỏ phiếu)
# DIRECT_SAMPLES=2       # số lời giải đọc bảng trực tiếp / câu
# SAMPLE_TEMPERATURE=0.7
# TABLE_TOKEN_BUDGET=20000   # giữ mọi request < 32K token -> bậc giá rẻ nhất của Qwen ($0.03 in / $0.13 out)
# MAX_TOKENS=16384       # trần output / lượt gọi (chống cắt cụt)
# LLM_TIMEOUT=180        # giây / lượt gọi
# MAX_REPAIRS=2          # số lần cho AI sửa code lỗi
# SOFT_DEADLINE=1800     # giây; quá mốc này: 1 lời giải mỗi đường, bỏ giám khảo
# MODE=full              # full = code + đọc trực tiếp + giám khảo | code = chỉ đường code

# --- Thử với nhà cung cấp khác (vd Gemini, API tương thích OpenAI). Ưu tiên hơn OPENROUTER_* nếu có.
# LLM_API_KEY=...
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# MODEL=gemini-3.5-flash-lite
# CONCURRENCY=2          # gói miễn phí: 500 request/ngày/project, giới hạn request/phút
# LLM_RETRIES=5
