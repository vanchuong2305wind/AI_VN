# Sao chép file này thành .env rồi điền API key. KHÔNG commit file .env.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
MODEL=qwen/qwen3.7-flash

# Mức suy luận của model: off | low | medium | high | default
REASONING=low

# Tuỳ chọn (đã có giá trị mặc định hợp lý)
# MODE=full              # full = code + đọc trực tiếp + giám khảo | code = chỉ đường code
# CONCURRENCY=8          # số câu xử lý song song
# MAX_REPAIRS=2          # số lần cho AI sửa code lỗi
# LLM_TIMEOUT=60         # giây / lượt gọi
# TABLE_TOKEN_BUDGET=20000
# SOFT_DEADLINE=1800     # giây; sau mốc này bỏ bước giám khảo
